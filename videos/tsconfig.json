{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./../../agentic-agent-node/web/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "react-blockies": [
        "./../../agentic-agent-node/web/node_modules/@types/react-blockies"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
